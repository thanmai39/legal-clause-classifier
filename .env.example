# Copy this file to .env and fill in your real values.
# .env is gitignored and must NEVER be committed.

# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Only needed locally, to run src/training/push_to_hub.py (uploading the
# trained model). NOT needed by the deployed API itself, since the model
# repo is public. Get a WRITE token from https://huggingface.co/settings/tokens
HF_TOKEN=your-huggingface-write-token-here

# Set this in your DEPLOYMENT environment (not needed locally, where the
# model is loaded from the local models/ folder instead) to make the API
# download the trained model from Hugging Face Hub instead of expecting
# it on disk. Not a secret -- just a public repo identifier.
# MODEL_HF_REPO_ID=your-username/legal-clause-classifier
